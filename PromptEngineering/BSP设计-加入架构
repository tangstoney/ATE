        .rx_buf_size = BOARD_UART_INSTR_RX_BUF_SIZE,
        .tx_buf_size = BOARD_UART_INSTR_TX_BUF_SIZE,
        .timeout_ms  = BOARD_UART_INSTR_TIMEOUT_MS,

#pragma once


/**
 * 很多嵌入式项目最后都会形成一个文件：bsp_pins.h ，这个文件负责 include 它们。
 * ================================================================
 * Board Support Package (BSP)
 * ================================================================
 *
 * This file defines board-specific hardware configuration.
 *
 * BSP provides a thin hardware adaptation layer that describes
 * how the current PCB connects to the MCU. Typical contents include:
 *
 *  - GPIO pin definitions
 *  - Peripheral instance selection (SPI/I2C/UART port)
 *  - Display resolution
 *  - Power rails
 *  - Board-specific constants
 *
 * IMPORTANT:
 * BSP only describes the hardware layout of the board.
 * It does NOT implement drivers or business logic.
 *
 * ------------------------------------------------
 * Architecture Position
 * ------------------------------------------------
 *
 * Application Layer
 * System Layer
 * Driver Layer
 * BSP (Board Hardware Definition)  <-- this file
 * ESP-IDF Platform
 * Hardware
 *
 * Driver modules should include this file to obtain
 * board-specific configuration values.
 *
 * ------------------------------------------------
 * Why BSP Exists
 * ------------------------------------------------
 *
 * Drivers should not contain hardcoded GPIO numbers or
 * board-specific configurations.
 *
 * When the hardware changes (new PCB revision), only the BSP
 * should need modification while higher-level software remains
 * unchanged.
 *
 * Example:
 *
 *      driver_display.c
 *          ↓
 *      include "bsp.h"
 *          ↓
 *      use BSP_LCD_RST_GPIO
 *
 * Instead of hardcoding:
 *
 *      #define LCD_RST_GPIO GPIO_NUM_29
 *
 * ------------------------------------------------
 * Current Project Design
 * ------------------------------------------------
 *
 * For simplicity, BSP is currently implemented as a header file
 * containing macro definitions only.
 *
 * Later this may evolve to:
 *
 *  - Kconfig configurable parameters
 *  - Board configuration structures
 *  - Multiple board variants
 *
 * ------------------------------------------------
 * Include Strategy
 * ------------------------------------------------
 *
 * Since this file resides in the `main` directory, other components
 * may include it using a project include path.
 *
 * Temporary solution:
 *
 *      #include "bsp.h"
 *
 * If needed, CMake can add the main directory to include paths:
 *
 *      target_include_directories(...)
 *
 * In the future BSP may be moved into a dedicated component.
 *
 * ------------------------------------------------
 * Usage Example
 * ------------------------------------------------
 *
 * Example usage inside a driver:
 *
 *      #include "bsp.h"
 *
 *      gpio_config_t rst = {
 *          .pin_bit_mask = 1ULL << BSP_LCD_RST_GPIO
 *      };
 *
 * ------------------------------------------------
 * Modification Rules
 * ------------------------------------------------
 *
 * Allowed:
 *
 *  - Pin definitions
 *  - Peripheral instance selection
 *  - Board hardware parameters
 *
 * Not allowed:
 *
 *  - Driver implementation
 *  - Application logic
 *  - System state management
 *
 * ================================================================
 */



#define POWER_EN_GPIO         (GPIO_NUM_45) // low cost p4 pcb
// #define POWER_EN_GPIO         (GPIO_NUM_11) // cyclone p4 pcb
// 10MHz 分辨率，1 tick = 0.1us（对 WS2812/幻彩类灯足够）
// 来自官方示例的配置方式
#define LED_STRIP_RMT_RES_HZ  (10 * 1000 * 1000)
#define LED_STRIP_GPIO_PIN        4      // 你的数据脚接在 GPIO4
#define LED_STRIP_LED_COUNT       6      // 串联 6 颗灯
#define LED_STRIP_MEMORY_BLOCK_WORDS 0 // let the driver choose a proper memory block size automatically
#define LED_STRIP_USE_DMA  1    // Set to 1 to use DMA for driving the LED strip, 0 otherwise





#define TOUCH_I2C_PORT       I2C_NUM_0
 /* GT911 support key num */
 #define ESP_GT911_TOUCH_MAX_BUTTONS         (5)
 #define TOUCH_DATA_SIZE sizeof(esp_lcd_touch_data_t)-sizeof(portMUX_TYPE)
#define k_lcd_h_res 800
#define k_lcd_v_res 1280
#define LCD_DISPLAY_BSP_EN_GPIO         (GPIO_NUM_20)
#define LCD_DISPLAY_BSP_PWM_GPIO        (GPIO_NUM_21)

// ===== Ethernet Configuration (ESP32-P4 RMII) =====
// These GPIO assignments correspond to the ESP32-P4 RMII interface
// Reference: ESP32-P4 Datasheet and reference design

// ===== RMII GPIO Configuration =====
// RMII Data Plane (TX/RX data and control signals)
#define BSP_ETH_RMII_TX_EN    GPIO_NUM_49    /*!< RMII TX Enable */
#define BSP_ETH_RMII_TXD0     GPIO_NUM_34    /*!< RMII TX Data 0 */
#define BSP_ETH_RMII_TXD1     GPIO_NUM_35    /*!< RMII TX Data 1 */
#define BSP_ETH_RMII_CRS_DV   GPIO_NUM_51    /*!< RMII CRS DV (Carrier Sense / RX DV) */
#define BSP_ETH_RMII_RXD0     GPIO_NUM_52    /*!< RMII RX Data 0 */
#define BSP_ETH_RMII_RXD1     GPIO_NUM_53    /*!< RMII RX Data 1 */

// ===== MDC/MDIO GPIO Configuration =====
// SMI (Serial Management Interface) for PHY register access
#define BSP_ETH_MDC_GPIO      GPIO_NUM_23    /*!< SMI MDC (Management Data Clock) */
#define BSP_ETH_MDIO_GPIO     GPIO_NUM_18    /*!< SMI MDIO (Management Data I/O) */

// ===== PHY Configuration =====
#define BSP_ETH_PHY_ADDR      0              /*!< PHY Address (0-31) */
#define BSP_ETH_PHY_RST_GPIO  GPIO_NUM_51    /*!< PHY Hardware Reset GPIO (or -1 to disable) */

// ===== RMII Clock Configuration =====
/**
 * @brief RMII clock mode
 * 
 * Options:
 * - EMAC_CLK_OUT:    ESP32 outputs reference clock to PHY
 * - EMAC_CLK_EXT_IN: PHY provides external reference clock
 */
#define BSP_ETH_CLK_MODE      EMAC_CLK_EXT_IN

/**
 * @brief RMII reference clock GPIO (if using EMAC_CLK_OUT)
 * 
 * This GPIO generates the 50MHz reference clock.
 * Typically GPIO_NUM_50 on ESP32-P4.
 */
#define BSP_ETH_CLK_GPIO      GPIO_NUM_50